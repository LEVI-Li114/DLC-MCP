TENCENTCLOUD_SECRET_ID=replace-me
TENCENTCLOUD_SECRET_KEY=replace-me
TENCENTCLOUD_REGION=ap-guangzhou
WEDATA_VERSION=2025-08-06
WEDATA_PROJECT_ID=replace-me

# Local asset store and raw sync dumps.
DLC_MCP_DB=/data/dlc-mcp/assets.db
DLC_MCP_SYNC_DIR=/data/dlc-mcp/sync
DLC_MCP_PYTHON=python3

# WeData pagination and table catalog sync.
WEDATA_PAGE_SIZE=100
WEDATA_SYNC_TABLE_CATALOG=1

# Optional. Each switch controls one metadata fact. Set to 0 to skip it.
# Start with a small limit, then raise it after sync is stable.
WEDATA_SYNC_FIELDS=0
WEDATA_SYNC_LINEAGE=0
WEDATA_SYNC_QUALITY=0
WEDATA_METADATA_TABLE_LIMIT=50
WEDATA_METADATA_TABLES=
WEDATA_METADATA_WORKERS=4

# One-off stable full table field sync. Keep this conservative to respect
# Tencent Cloud API rate limits.
WEDATA_FULL_FIELDS_REQUEST_INTERVAL=0.3
WEDATA_FULL_FIELDS_MAX_RETRIES=5
WEDATA_FULL_FIELDS_RETRY_BASE_SLEEP=2
WEDATA_FULL_FIELDS_PROGRESS_EVERY=50
WEDATA_FULL_FIELDS_FORCE=0
WEDATA_FULL_FIELDS_FAIL_ON_ERROR=0

# One-off stable full sync for task mappings, lineage, and quality rules.
# Each switch controls one fact; task instances are queried live instead.
# Keep conservative to respect Tencent Cloud API rate limits.
WEDATA_FULL_FACTS_REQUEST_INTERVAL=0.3
WEDATA_FULL_FACTS_MAX_RETRIES=5
WEDATA_FULL_FACTS_RETRY_BASE_SLEEP=2
WEDATA_FULL_FACTS_PROGRESS_EVERY=50
WEDATA_FULL_FACTS_FAIL_ON_ERROR=0

# deploy/sync-wedata-full.sh switches. Default 0 (off); set to 1 to enable.
DLC_MCP_FULL_SYNC_TASKS=0
DLC_MCP_FULL_SYNC_TASK_DETAILS=0
DLC_MCP_FULL_SYNC_LINEAGE=0
DLC_MCP_FULL_SYNC_QUALITY=0

# Optional. Set to 1 to sync ListDataSources and GetDataSourceRelatedTasks.
WEDATA_SYNC_DATA_SOURCES=0

# Task run instances are fetched live per query (ListTaskInstances), so no
# batch instance sync is configured here. Only the timezone is needed.
WEDATA_INSTANCE_TIMEZONE=UTC+8

# Optional. Partition facts for get_table_partition_profile.
WEDATA_SYNC_PARTITIONS=0
WEDATA_PARTITION_SERVICE=dlc
WEDATA_PARTITION_ACTION=DescribeTablePartitions
WEDATA_PARTITION_PAYLOAD_MODE=table
WEDATA_PARTITION_DATE=
# Optional. Table-level storage size and heat value via DLC DescribeTable (HeatValue/StorageSize).
WEDATA_SYNC_TABLE_STATS=0
DLC_API_VERSION=2021-01-25
DLC_CATALOG=DataLakeCatalog
DLC_QUERY_TASK_TYPE=spark
DLC_QUERY_ENGINE=
DLC_QUERY_DATABASE=
DLC_QUERY_DATASOURCE=DataLakeCatalog
DLC_QUERY_RESOURCE_GROUP=
DLC_QUERY_MAX_SQL_CHARS=100000
DLC_QUERY_DATA_FIELD_CUT_LEN=1000

# Sync post-checks. Keep enabled so every run reports health, coverage, and top gaps.
DLC_MCP_SYNC_HEALTH_CHECK=1
DLC_MCP_SYNC_GAP_TYPES=fields,lineage,quality,tasks,runs,data_source
DLC_MCP_SYNC_GAP_LIMIT=20

# Daily scheduler. deploy/sync-wedata-incremental.sh runs daily at 08:00.
# Each switch controls one fact; set to 0 to skip it for the daily run.
DLC_MCP_DAILY_SYNC_TABLE_CATALOG=1
DLC_MCP_DAILY_SYNC_TASKS=1
DLC_MCP_DAILY_SYNC_TASK_DETAILS=1
DLC_MCP_DAILY_SYNC_FIELDS=1
DLC_MCP_DAILY_SYNC_LINEAGE=1
DLC_MCP_DAILY_SYNC_QUALITY=1
DLC_MCP_DAILY_NEW_ASSET_STRICT=1
# WEDATA_NEW_ASSET_DATE_FIELDS groups: create uses table CreateTime; update uses generic
# UpdateTime/ModifyTime fields; structure_update uses DMS StructUpdateTime (structure/schema update time).
DLC_MCP_DAILY_NEW_ASSET_DATE_FIELDS=structure_update,update,create
DLC_MCP_DAILY_METADATA_TABLE_LIMIT=100000
DLC_MCP_DAILY_SYNC_DATA_SOURCES=1
DLC_MCP_DAILY_SYNC_PARTITIONS=0

# HTTP Gateway for user access.
DLC_MCP_GATEWAY_HOST=0.0.0.0
DLC_MCP_GATEWAY_PORT=8787
DLC_MCP_GATEWAY_TOKEN=replace-with-random-token
